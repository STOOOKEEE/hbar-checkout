# Server-only configuration. Never put a signing key in this package.
HEDERA_NETWORK=testnet
HEDERA_TOKEN_ID=0.0.5449
# Filled after npm run hardhat:deploy. Use the EVM address emitted by deployment.
HEDERA_CHECKOUT_ADDRESS=
# Optional, public (not a secret): enables HashPack through WalletConnect.
# Create one at https://cloud.reown.com. MetaMask works without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Funded Hedera TESTNET ECDSA secp256k1 private key, 0x-prefixed, 32 bytes.
# An ED25519 key cannot sign Ethereum transactions. Never commit this file with a real key.
HEDERA_PRIVATE_KEY=
# Optional: use a separately funded ECDSA payer in the live payment smoke.
HEDERA_PAYER_PRIVATE_KEY=
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_TOKEN_ID=0.0.5449
# Conversion cap for the optional testnet payment smoke, excluding network fees.
MAX_TESTNET_HBAR=1
